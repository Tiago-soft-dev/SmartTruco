<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HistoricoJogadas">

    <TextView
        android:id="@+id/tv_hist_jog_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Jogador1"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_hist_jog_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="184dp"
        android:text="Jogador2"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_jog1_vit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:text="00"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_hist_jog_1"
        app:layout_constraintStart_toEndOf="@+id/tv_hist_jog_1"
        app:layout_constraintTop_toTopOf="@+id/tv_jog_1"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/tv_jog2_vit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="00"
        android:textSize="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_jog_2"
        app:layout_constraintStart_toEndOf="@+id/tv_hist_jog_2"
        app:layout_constraintTop_toTopOf="@+id/tv_hist_jog_2" />

</androidx.constraintlayout.widget.ConstraintLayout>